{
  "name": "@organigram/protocol",
  "version": "0.1.1",
  "description": "Smart contract framework for building incorruptible organizations",
  "author": "Organigram (https://organigram.ai)",
  "contributors": [
    "alex <alex@organigr.am> (https://github.com/alxmhe)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:organigram/organigram.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "env-cmd --silent forge build",
    "docs": "env-cmd --silent tsx scripts/docs.ts",
    "test": "env-cmd --silent forge test",
    "deploy:protocol": "env-cmd --silent pnpm clean && pnpm build && tsx scripts/deploy.ts",
    "format": "env-cmd --silent tsx scripts/format.ts",
    "anvil": "env-cmd --silent node scripts/anvil.js",
    "clean": "rm -rf out cache_forge broadcast"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0"
  },
  "devDependencies": {
    "@openzeppelin/test-environment": "^0.1.9",
    "@types/chai": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.37",
    "bs58": "^6.0.0",
    "chai": "^4.3.4",
    "ganache": "^7.9.2",
    "mocha": "^10.7.0",
    "viem": "^2.18.2"
  },
  "gitHead": "5aeceb89fcac23a06b21969c01c8bfdd36cea896"
}
