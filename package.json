{
  "name": "@organigram/protocol",
  "version": "0.1.2",
  "description": "Smart contract framework for building incorruptible organizations",
  "author": "Organigram (https://organigram.ai)",
  "contributors": [
    "alex <alex@organigr.am> (https://github.com/alxmhe)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:organigram/organigram.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "env-cmd --silent forge build --skip ./test/**",
    "docs:generate": "env-cmd --silent tsx scripts/docs.ts",
    "test": "env-cmd --silent forge test --offline",
    "analyze:slither": "FOUNDRY_OUT=cache_slither FOUNDRY_CACHE_PATH=cache_slither_cache VIRTUAL_ENV=.venv .venv/bin/slither . --foundry-out-directory cache_slither --filter-paths \"abi|cache_forge|cache_slither|node_modules|test\" --exclude-dependencies --exclude-low --exclude-informational",
    "deploy:protocol": "env-cmd --silent tsx scripts/deploy.ts",
    "format": "env-cmd --silent tsx scripts/format.ts",
    "anvil": "env-cmd --silent node scripts/anvil.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "viem": "^2.18.2"
  },
  "gitHead": "5aeceb89fcac23a06b21969c01c8bfdd36cea896"
}
